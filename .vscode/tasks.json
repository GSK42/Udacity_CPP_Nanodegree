{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build active file",
            "type": "shell",
            "command": "C:\\mingw-w64\\i686-8.1.0-posix-dwarf-rt_v6-rev0\\mingw32\\bin\\g++.exe",
            "args": [
                "-g", "-Wall", "-Wextra", "-std=c++17",
                "${file}",
                "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Build folder (all .cpp files)",
            "type": "shell",
            "command": "& 'C:\\mingw-w64\\i686-8.1.0-posix-dwarf-rt_v6-rev0\\mingw32\\bin\\g++.exe' -g -Wall -Wextra -std=c++17 (Get-ChildItem -Path '${fileDirname}' -Filter *.cpp | ForEach-Object FullName) -o '${fileDirname}\\${fileDirnameBasename}.exe'",
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "Build & Run active file",
            "type": "shell",
            "command": "& 'C:\\mingw-w64\\i686-8.1.0-posix-dwarf-rt_v6-rev0\\mingw32\\bin\\g++.exe' -g -std=c++17 '${file}' -o '${fileDirname}\\${fileBasenameNoExtension}.exe'; if ($?) { & '${fileDirname}\\${fileBasenameNoExtension}.exe' }",
            "options": { "cwd": "${fileDirname}" },
            "presentation": { "reveal": "always", "panel": "shared", "focus": true, "clear": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Clean Files",
            "type": "shell",
            "command": "Get-ChildItem -Include *.o, *.exe -Recurse -Force -ErrorAction SilentlyContinue | Remove-Item -Force -ErrorAction SilentlyContinue; Write-Host 'Removed all .o and .exe files' -ForegroundColor Green",
            "problemMatcher": []
        }
    ]
}